---
import { SITE } from '../config/site';
import { NAV_LINKS } from '../data/silo';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-slate-950/95 backdrop-blur-md border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo Brand (Bersih tanpa badge PLG) -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-11 h-11 rounded-xl bg-white flex items-center justify-center p-2 shadow-lg shadow-emerald-950/50 group-hover:scale-105 transition-transform">
          <svg class="w-full h-full" viewBox="0 0 1073 935" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" fill="rgb(255, 102, 52)" d="M1040 662c-9.5 17-23.6 40.4-31 47l-.9 149.9c0 42.8-33.5 76.8-76.5 76.8H138c-41.97 0-76-34-76-76.8v-34.6c-5.94-2.4-17.64-7-29-11.4-16.37-6.3-33-15-33-15l58-86-32 72 36 13.7v-.16c46.33 17.74 139.25 46.79 274 57.5 97.43 9.43 279.86 2 421-44 129.95-41.75 227.28-112.36 251.92-131.23 7.04-7.6 20.53-22.58 32.58-38.77 17.4-21.15 31.1-45.85 31.1-45.85s-12 36.91-32 67.89ZM574 746c-203.55 33.92-466.1-85-466.1-85L62 731V450.18c19.63 27.67 75.73 86.36 162 98.83 117.63 16.99 192-2 192-2l261-47s192.29-41.84 237.43 27.85C960.71 597.84 779.44 713.98 574 746Z"/>
            <path fill-rule="evenodd" fill="rgb(34, 77, 168)" d="M886 437c-79.91-13.83-188-3-188-3s57.05-20.31 101-47c36.94-22.44 62.05-52 62.05-52L749 242s17.41 74.55-92 118C518.54 415.84 240.15 422.54 219.1 337 178.76 161.93 689 125 689 125S461.19 111.26 259 172c-105.9 33.24-179.53 109.06-197.9 128.36V75c0-41.97 35.03-76 77-76h794c42.97 0 77 34.03 77 76v411.53c-9.85-7.06-55.89-37.92-123-49.53Z"/>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-base sm:text-lg font-bold text-white tracking-tight leading-none mb-1">
            PAGAR MODERN PALEMBANG
          </span>
          <span class="text-xs text-amber-400 font-medium tracking-wide">
            by Sriwijaya Grafika
          </span>
        </div>
      </a>

      <!-- Desktop Navigation: Beranda, Produk, Motif Ornamen, Blog, Kontak -->
      <nav class="hidden lg:flex items-center gap-7" aria-label="Menu Navigasi Utama">
        {NAV_LINKS.map((item) => {
          const hasChildren = item.children && item.children.length > 0;
          const isActive = currentPath === item.url || (item.url !== '/' && currentPath.startsWith(item.url));

          if (hasChildren) {
            return (
              <div class="relative group">
                <a
                  href={item.url}
                  class={`text-sm font-medium transition-colors flex items-center gap-1.5 py-2 ${
                    isActive ? 'text-emerald-400 font-semibold' : 'text-slate-300 hover:text-white'
                  }`}
                >
                  {item.label}
                  <svg class="w-4 h-4 text-slate-400 group-hover:text-emerald-400 transition-transform group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                  </svg>
                </a>

                <!-- Dropdown Menu Produk -->
                <div class="absolute left-0 top-full pt-2 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
                  <div class="w-64 rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl p-2 space-y-1">
                    {item.children?.map((sub) => (
                      <a
                        href={sub.url}
                        class="block px-3.5 py-2.5 rounded-xl hover:bg-slate-800/80 transition-colors group/sub"
                      >
                        <div class="text-sm font-semibold text-white group-hover/sub:text-emerald-400">
                          {sub.label}
                        </div>
                        {sub.description && (
                          <div class="text-[11px] text-slate-400 mt-0.5">
                            {sub.description}
                          </div>
                        )}
                      </a>
                    ))}
                    <div class="pt-2 mt-1 border-t border-slate-800/80">
                      <a
                        href="/#produk"
                        class="block px-3 py-2 text-center text-xs font-bold text-emerald-400 hover:text-amber-400 transition-colors rounded-lg bg-slate-950/50"
                      >
                        Lihat 6 Kategori Produk ↓
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            );
          }

          return (
            <a
              href={item.url}
              class={`text-sm font-medium transition-colors ${
                isActive ? 'text-emerald-400 font-semibold' : 'text-slate-300 hover:text-white'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Action Button -->
      <div class="hidden sm:flex items-center gap-4">
        <a
          href={`https://wa.me/${SITE.contact.whatsapp}?text=${SITE.contact.whatsappText}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-500 hover:from-emerald-500 hover:to-emerald-400 text-white text-sm font-semibold shadow-md shadow-emerald-950 transition-all hover:scale-102"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.448.739.96 1.196.659.587 1.215.769 1.388.856.173.086.275.072.376-.044.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564c.173.087.289.13.332.202.043.073.043.419-.101.824z" />
          </svg>
          Konsultasi Gratis
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-900 focus:outline-none"
        aria-label="Toggle Menu"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-800 bg-slate-950 px-4 pt-3 pb-6 space-y-2">
    {NAV_LINKS.map((item) => (
      <div>
        <a
          href={item.url}
          class="block px-3 py-2 rounded-lg text-base font-semibold text-slate-200 hover:text-white hover:bg-slate-900"
        >
          {item.label}
        </a>
        {item.children && (
          <div class="pl-4 py-1 space-y-1 border-l-2 border-slate-800 ml-3">
            {item.children.map((sub) => (
              <a
                href={sub.url}
                class="block px-3 py-1.5 text-sm text-slate-400 hover:text-emerald-400"
              >
                • {sub.label}
              </a>
            ))}
          </div>
        )}
      </div>
    ))}
    <div class="pt-4 border-t border-slate-800">
      <a
        href={`https://wa.me/${SITE.contact.whatsapp}?text=${SITE.contact.whatsappText}`}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 w-full px-4 py-3 rounded-xl bg-emerald-600 text-white font-semibold"
      >
        WhatsApp: 0852-1511-1125
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
