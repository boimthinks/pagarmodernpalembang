---
interface Props {
  title: string;
  excerpt: string;
  slug: string;
  kategori?: string;
  topik?: string;
  imgurl?: string;
  imgalt?: string;
}

const {
  title,
  excerpt,
  slug,
  kategori = 'pagar',
  topik,
  imgurl = '/og-default.svg',
  imgalt
} = Astro.props;

const motifUrl = `/${kategori}/${slug}/`;
---

<div class="group rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-emerald-500/40 overflow-hidden flex flex-col justify-between transition-all duration-300 hover:shadow-xl hover:shadow-emerald-950/30">
  <div>
    <!-- Gambar Rasio 4:3 -->
    <a href={motifUrl} class="block aspect-[4/3] overflow-hidden bg-slate-950 relative">
      <img
        src={imgurl}
        alt={imgalt || title}
        width="400"
        height="300"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
        decoding="async"
      />
      <span class="absolute top-3 left-3 px-2.5 py-1 rounded-md bg-slate-950/80 backdrop-blur-sm text-emerald-400 font-semibold text-xs border border-emerald-500/30 uppercase tracking-wide">
        {kategori}
      </span>
      {topik && (
        <span class="absolute top-3 right-3 px-2.5 py-1 rounded-md bg-slate-900/90 text-slate-300 text-[11px] font-medium border border-slate-700">
          {topik}
        </span>
      )}
    </a>

    <!-- Konten Teks -->
    <div class="p-6 space-y-3">
      <h3 class="text-lg font-bold text-white group-hover:text-emerald-400 transition-colors leading-snug">
        <a href={motifUrl}>
          {title}
        </a>
      </h3>

      <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed">
        {excerpt}
      </p>
    </div>
  </div>

  <div class="px-6 pb-6 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs mt-auto">
    <a href={motifUrl} class="text-emerald-400 font-semibold hover:underline flex items-center gap-1">
      Lihat Detail Motif <span>→</span>
    </a>
    <a
      href={`https://wa.me/6285215111125?text=Halo%20Sriwijaya%20Grafika%2C%20saya%20tertarik%20dengan%20katalog%20${encodeURIComponent(title)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="text-amber-400 font-semibold hover:underline"
    >
      Request Mockup
    </a>
  </div>
</div>
