---
interface Props {
  title: string;
  excerpt: string;
  date: string;
  topik?: string;
  slug: string;
  kategori?: string;
  imgurl?: string;
  imgalt?: string;
}

const {
  title,
  excerpt,
  date,
  topik,
  slug,
  kategori = 'pagar',
  imgurl = '/og-default.svg',
  imgalt
} = Astro.props;

const articleUrl = `/${kategori}/${slug}/`;
---

<article class="group rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-emerald-500/40 overflow-hidden flex flex-col justify-between transition-all duration-300 hover:shadow-xl hover:shadow-emerald-950/30">
  <div>
    <!-- Gambar Rasio 4:3 -->
    <a href={articleUrl} class="block aspect-[4/3] overflow-hidden bg-slate-950 relative">
      <img
        src={imgurl}
        alt={imgalt || title}
        width="400"
        height="300"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
        decoding="async"
      />
      {topik && (
        <span class="absolute top-3 left-3 px-2.5 py-1 rounded-md bg-slate-950/80 backdrop-blur-sm text-emerald-400 font-semibold text-xs border border-emerald-500/30 uppercase tracking-wide">
          {topik}
        </span>
      )}
    </a>

    <!-- Konten Teks -->
    <div class="p-6 space-y-3">
      <div class="flex items-center justify-between text-xs text-slate-400">
        <span class="uppercase tracking-wider font-medium text-emerald-400/90">{kategori}</span>
        <time datetime={date}>{date}</time>
      </div>

      <h3 class="text-lg font-bold text-white group-hover:text-emerald-400 transition-colors leading-snug">
        <a href={articleUrl}>
          {title}
        </a>
      </h3>

      <p class="text-sm text-slate-400 line-clamp-2 leading-relaxed">
        {excerpt}
      </p>
    </div>
  </div>

  <div class="px-6 pb-6 pt-2 border-t border-slate-800/60 mt-auto">
    <a
      href={articleUrl}
      class="text-xs font-semibold text-emerald-400 hover:text-amber-400 transition-colors flex items-center gap-1.5"
    >
      Baca Panduan Lengkap <span class="group-hover:translate-x-1 transition-transform">→</span>
    </a>
  </div>
</article>
