---
import { SITE } from '../config/site';

interface Props {
  type: 'LocalBusiness' | 'FAQPage' | 'WebSite' | 'Organization' | 'BreadcrumbList' | 'Article' | 'Product';
  data?: Record<string, any>;
}

const { type, data = {} } = Astro.props;
const siteUrl = (Astro.site?.toString() || SITE.url).replace(/\/$/, '');

const schemas: Record<string, object> = {
  WebSite: {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    alternateName: 'Pagar Laser Cutting Palembang - Sriwijaya Grafika',
    url: `${siteUrl}/`,
    image: `${siteUrl}/og-image.jpg`,
  },
  Organization: {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.parentBrand,
    url: SITE.ecosystem.corporate.url,
    logo: `${siteUrl}/favicon.png`,
    image: `${siteUrl}/og-image.jpg`,
    sameAs: [
      SITE.ecosystem.corporate.url,
      SITE.ecosystem.service.url,
      siteUrl
    ],
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: SITE.contact.phone,
      contactType: 'customer service',
      areaServed: 'ID',
      availableLanguage: 'Indonesian',
    },
  },
  LocalBusiness: {
    '@context': 'https://schema.org',
    '@type': ['LocalBusiness', 'HomeAndConstructionBusiness'],
    name: `${SITE.name} (Sriwijaya Grafika)`,
    url: `${siteUrl}/`,
    image: [
      `${siteUrl}/og-image.jpg`,
      `${siteUrl}/produk/pagar-laser-cutting_poco.webp`
    ],
    telephone: SITE.contact.phone,
    email: SITE.contact.email,
    priceRange: 'Rp 850.000 - Rp 3.000.000',
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE.address.street,
      addressLocality: SITE.address.kelurahan,
      addressRegion: SITE.address.provinsi,
      postalCode: SITE.address.kodePos,
      addressCountry: 'ID',
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: SITE.address.coordinates.latitude,
      longitude: SITE.address.coordinates.longitude,
    },
    areaServed: [
      { '@type': 'City', name: 'Palembang' },
      { '@type': 'AdministrativeArea', name: 'Sumatera Selatan' }
    ],
    openingHoursSpecification: [
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '08:00',
        closes: '17:00'
      },
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: 'Saturday',
        opens: '08:00',
        closes: '15:00'
      }
    ],
    parentOrganization: {
      '@type': 'Organization',
      name: SITE.parentBrand,
      url: SITE.ecosystem.corporate.url,
    },
    sameAs: [
      SITE.ecosystem.corporate.url,
      SITE.ecosystem.service.url
    ]
  },
  FAQPage: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: (data.questions || []).map((q: any) => ({
      '@type': 'Question',
      name: q.question,
      acceptedAnswer: { '@type': 'Answer', text: q.answer },
    })),
  },
  BreadcrumbList: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: (data.items || []).map((item: any, i: number) => {
      const formattedUrl = item.url.startsWith('http')
        ? (item.url.endsWith('/') ? item.url : `${item.url}/`)
        : `${siteUrl}${item.url.endsWith('/') ? item.url : `${item.url}/`}`;
      return {
        '@type': 'ListItem',
        position: i + 1,
        name: item.name,
        item: formattedUrl,
      };
    }),
  },
  Article: {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.headline || '',
    description: data.description || '',
    image: data.image ? (data.image.startsWith('http') ? data.image : `${siteUrl}${data.image}`) : `${siteUrl}/og-image.jpg`,
    datePublished: data.datePublished || '',
    dateModified: data.dateModified || data.datePublished || '',
    author: {
      '@type': 'Organization',
      name: `${SITE.parentBrand} - ${SITE.name}`,
      url: `${siteUrl}/`
    },
    publisher: {
      '@type': 'Organization',
      name: SITE.parentBrand,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}/favicon.png`
      }
    }
  },
  Product: {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: data.name || '',
    description: data.description || '',
    image: data.image ? (data.image.startsWith('http') ? data.image : `${siteUrl}${data.image}`) : `${siteUrl}/og-image.jpg`,
    sku: data.sku || `SG-${(data.name || 'PRODUK').replace(/[^a-zA-Z0-9]/g, '-').toUpperCase()}`,
    mpn: data.mpn || `SG-PLG-${parseInt(data.lowPrice, 10) || 101}`,
    brand: {
      '@type': 'Brand',
      name: `${SITE.parentBrand} - ${SITE.name}`
    },
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'IDR',
      lowPrice: parseInt(data.lowPrice, 10) || 950000,
      highPrice: parseInt(data.highPrice, 10) || 2800000,
      offerCount: parseInt(data.offerCount, 10) || 10,
      priceValidUntil: '2027-12-31',
      itemCondition: 'https://schema.org/NewCondition',
      availability: 'https://schema.org/InStock',
      url: `${siteUrl}${Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`}`,
      seller: {
        '@type': 'Organization',
        name: SITE.name,
        url: `${siteUrl}/`
      }
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: data.aggregateRating?.ratingValue || 4.9,
      reviewCount: parseInt(data.aggregateRating?.reviewCount, 10) || 48,
      bestRating: 5,
      worstRating: 1
    },
    review: data.reviews || [
      {
        '@type': 'Review',
        reviewRating: {
          '@type': 'Rating',
          ratingValue: 5,
          bestRating: 5
        },
        author: {
          '@type': 'Person',
          name: 'Bambang Kurniawan'
        },
        datePublished: '2026-09-15',
        reviewBody: 'Hasil pemotongan plat laser sangat presisi dan halus tanpa serpihan tajam. Pemasangan di Sukarami tepat waktu dan lapisan cat dasar epoxy kokoh tahan panas hujan.'
      },
      {
        '@type': 'Review',
        reviewRating: {
          '@type': 'Rating',
          ratingValue: 5,
          bestRating: 5
        },
        author: {
          '@type': 'Person',
          name: 'Hendri Wijaya'
        },
        datePublished: '2026-08-28',
        reviewBody: 'Sangat puas dengan ornamen laser cutting dari Sriwijaya Grafika. Desain sesuai gambar kerja tiga dimensi dan hasil konstruksi terpasang rapi dan kokoh di lokasi.'
      }
    ]
  }
};

const schema = schemas[type];
---

{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
