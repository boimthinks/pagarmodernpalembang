---
import { SITE } from '../config/site';
import { PRODUCT_CATEGORIES } from '../data/silo';
import Icon from './Icon.astro';
---

<footer class="bg-slate-950 border-t border-slate-800 text-slate-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Kolom 1: Profil Brand & Induk -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-white flex items-center justify-center p-1.5 shadow-md">
            <svg class="w-full h-full" viewBox="0 0 1073 935" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" fill="rgb(255, 102, 52)" d="M1040 662c-9.5 17-23.6 40.4-31 47l-.9 149.9c0 42.8-33.5 76.8-76.5 76.8H138c-41.97 0-76-34-76-76.8v-34.6c-5.94-2.4-17.64-7-29-11.4-16.37-6.3-33-15-33-15l58-86-32 72 36 13.7v-.16c46.33 17.74 139.25 46.79 274 57.5 97.43 9.43 279.86 2 421-44 129.95-41.75 227.28-112.36 251.92-131.23 7.04-7.6 20.53-22.58 32.58-38.77 17.4-21.15 31.1-45.85 31.1-45.85s-12 36.91-32 67.89ZM574 746c-203.55 33.92-466.1-85-466.1-85L62 731V450.18c19.63 27.67 75.73 86.36 162 98.83 117.63 16.99 192-2 192-2l261-47s192.29-41.84 237.43 27.85C960.71 597.84 779.44 713.98 574 746Z"/>
              <path fill-rule="evenodd" fill="rgb(34, 77, 168)" d="M886 437c-79.91-13.83-188-3-188-3s57.05-20.31 101-47c36.94-22.44 62.05-52 62.05-52L749 242s17.41 74.55-92 118C518.54 415.84 240.15 422.54 219.1 337 178.76 161.93 689 125 689 125S461.19 111.26 259 172c-105.9 33.24-179.53 109.06-197.9 128.36V75c0-41.97 35.03-76 77-76h794c42.97 0 77 34.03 77 76v411.53c-9.85-7.06-55.89-37.92-123-49.53Z"/>
            </svg>
          </div>
          <div>
            <h3 class="text-white font-bold text-lg leading-tight">Pagar Modern Palembang</h3>
            <p class="text-xs text-amber-400 font-medium">Divisi Arsitektur Sriwijaya Grafika</p>
          </div>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed">
          Spesialis produksi pagar, gerbang dorong/lipat, balkon, dan railing tangga plat cutting laser presisi tinggi di Kota Palembang sejak 2008.
        </p>
        <div class="pt-2 text-xs text-slate-500 space-y-1">
          <p>Workshop: Talang Jambe, Sukarami, Palembang</p>
          <p>Garansi Konstruksi 1 Tahun & Free Mockup 3D</p>
        </div>
      </div>

      <!-- Kolom 2: Navigasi Kategori SILO -->
      <div>
        <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
          Kategori Produk
        </h4>
        <ul class="space-y-2.5 text-sm">
          {PRODUCT_CATEGORIES.map((cat) => (
            <li>
              <a href={cat.url} class="hover:text-emerald-400 transition-colors flex items-center gap-1.5">
                <span class="text-emerald-500 text-xs">▸</span>
                {cat.fullName}
              </a>
            </li>
          ))}
          <li>
            <a href="/motif-laser-cutting/" class="hover:text-emerald-400 transition-colors flex items-center gap-1.5">
              <span class="text-emerald-500 text-xs">▸</span>
              Motif Ornamen Cutting
            </a>
          </li>
          <li>
            <a href="/area-layanan/palembang/" class="hover:text-emerald-400 transition-colors flex items-center gap-1.5">
              <span class="text-emerald-500 text-xs">▸</span>
              Area Layanan Palembang & Sumsel
            </a>
          </li>
        </ul>
      </div>

      <!-- Kolom 3: Ekosistem 3 Website Sriwijaya Grafika -->
      <div>
        <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
          Ekosistem Kami
        </h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a
              href={SITE.ecosystem.corporate.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group block p-2.5 rounded-lg bg-slate-900/60 hover:bg-slate-900 border border-slate-800/80 transition-all"
            >
              <div class="text-white font-medium text-xs group-hover:text-emerald-400 flex items-center justify-between">
                <span>SriwijayaGrafika.com</span>
                <Icon name="open_in_new" size={14} class="text-slate-400 group-hover:text-emerald-400" />
              </div>
              <div class="text-[11px] text-slate-400">Induk Percetakan & Advertising</div>
            </a>
          </li>
          <li>
            <a
              href={SITE.ecosystem.service.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group block p-2.5 rounded-lg bg-slate-900/60 hover:bg-slate-900 border border-slate-800/80 transition-all"
            >
              <div class="text-white font-medium text-xs group-hover:text-amber-400 flex items-center justify-between">
                <span>LaserindoPalembang.com</span>
                <Icon name="open_in_new" size={14} class="text-slate-400 group-hover:text-amber-400" />
              </div>
              <div class="text-[11px] text-slate-400">Jasa Mesin Laser Cutting Maklon Mentah</div>
            </a>
          </li>
          <li>
            <a
              href={SITE.url}
              class="group block p-2.5 rounded-lg bg-emerald-950/30 border border-emerald-900/40"
            >
              <div class="text-emerald-400 font-medium text-xs">PagarModernPalembang.com</div>
              <div class="text-[11px] text-slate-300">Hasil Produk Jadi Pagar Siap Pasang</div>
            </a>
          </li>
        </ul>
      </div>

      <!-- Kolom 4: Alamat & Kontak (NAP) -->
      <div>
        <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
          Kontak & Workshop
        </h4>
        <div class="space-y-3 text-sm">
          <p class="leading-relaxed text-slate-300">
            <strong class="text-white block mb-0.5">Alamat Workshop:</strong>
            {SITE.address.full}
          </p>
          <p class="text-slate-300">
            <strong class="text-white block mb-0.5">WhatsApp / Telepon:</strong>
            <a href={`https://wa.me/${SITE.contact.whatsapp}`} class="text-emerald-400 font-semibold hover:underline">
              {SITE.contact.phone}
            </a>
          </p>
          <p class="text-xs text-slate-400">
            Senin - Sabtu: 08:00 - 17:00 WIB<br />
            (Minggu / Hari Libur dengan Perjanjian)
          </p>
          <div class="pt-1">
            <a
              href={SITE.address.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-amber-400 hover:text-amber-300"
            >
              <Icon name="location_on" size={16} class="text-emerald-400" />
              <span>Buka Petunjuk Arah Google Maps</span>
              <Icon name="open_in_new" size={14} class="text-amber-400" />
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Copyright Bar -->
    <div class="mt-12 pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>
        © {new Date().getFullYear()} {SITE.name}. Hak Cipta Dilindungi. Bagian dari ekosistem 
        <a href={SITE.ecosystem.corporate.url} class="text-slate-400 hover:text-white underline">Sriwijaya Grafika</a>.
      </p>
      <div class="flex items-center gap-6">
        <a href="/tentang-sriwijaya-grafika/" class="hover:text-slate-300">Tentang Kami</a>
        <a href="/kontak/" class="hover:text-slate-300">Hubungi Kami</a>
        <a href="/area-layanan/palembang/" class="hover:text-slate-300">Area Palembang</a>
      </div>
    </div>
  </div>
</footer>
