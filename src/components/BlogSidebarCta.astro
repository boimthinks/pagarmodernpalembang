---
import { SITE } from '../config/site';

interface Props {
  categoryName?: string;
}

const { categoryName = 'Produk Laser Cutting' } = Astro.props;
const waMessage = encodeURIComponent(`Halo Sriwijaya Grafika, saya ingin konsultasi mengenai ${categoryName} setelah membaca artikel di website.`);
---

<div class="p-5 rounded-2xl bg-gradient-to-b from-slate-900 to-slate-950 border border-emerald-500/30 shadow-xl space-y-4">
  <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-[11px] font-bold uppercase tracking-wider">
    <span class="material-symbols-outlined text-[14px] text-amber-400">verified</span>
    Workshop Palembang
  </div>

  <div class="space-y-1">
    <h3 class="text-base font-bold text-white leading-snug">
      Konsultasi Fabrikasi Logam
    </h3>
    <p class="text-xs text-slate-300 leading-relaxed">
      Dapatkan saran pemilihan bahan, ketebalan plat, dan estimasi biaya gratis langsung dari tim teknis workshop.
    </p>
  </div>

  <ul class="space-y-2 py-2 border-y border-slate-800 text-xs text-slate-300">
    <li class="flex items-center gap-2">
      <span class="material-symbols-outlined text-emerald-400 text-[16px] leading-none shrink-0">check_circle</span>
      <span>Mesin laser fiber milik sendiri</span>
    </li>
    <li class="flex items-center gap-2">
      <span class="material-symbols-outlined text-emerald-400 text-[16px] leading-none shrink-0">check_circle</span>
      <span>Gratis survey lokasi area Palembang</span>
    </li>
    <li class="flex items-center gap-2">
      <span class="material-symbols-outlined text-emerald-400 text-[16px] leading-none shrink-0">check_circle</span>
      <span>Simulasi desain CAD transparan</span>
    </li>
  </ul>

  <a
    href={`https://wa.me/${SITE.contact.whatsapp}?text=${waMessage}`}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center justify-center gap-2.5 w-full py-3 px-4 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-bold text-xs shadow-lg shadow-emerald-950/60 transition-all hover:scale-[1.02]"
  >
    <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.448.739.96 1.196.659.587 1.215.769 1.388.856.173.086.275.072.376-.044.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564c.173.087.289.13.332.202.043.073.043.419-.101.824z" />
    </svg>
    <span>Chat WhatsApp 0852-1511-1125</span>
  </a>

  <div class="text-[11px] text-slate-400 text-center flex items-center justify-center gap-1">
    <span class="material-symbols-outlined text-[14px] text-slate-500">location_on</span>
    <span>Talang Jambe, Sukarami, Palembang</span>
  </div>
</div>
