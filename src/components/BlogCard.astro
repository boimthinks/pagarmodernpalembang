---
interface Props {
  title: string;
  excerpt: string;
  date: string;
  topik?: string;
  slug: string;
  kategori?: string;
}

const { title, excerpt, date, topik, slug, kategori = 'pagar' } = Astro.props;
const articleUrl = `/${kategori}/${slug}/`;
---

<article class="group rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-emerald-500/40 p-6 flex flex-col justify-between transition-all hover:shadow-xl hover:shadow-emerald-950/30">
  <div class="space-y-3">
    <div class="flex items-center justify-between text-xs text-slate-400">
      {topik && (
        <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 font-medium border border-emerald-500/20 uppercase tracking-wide">
          {topik}
        </span>
      )}
      <time datetime={date}>{date}</time>
    </div>

    <h3 class="text-lg font-bold text-white group-hover:text-emerald-400 transition-colors leading-snug">
      <a href={articleUrl}>
        {title}
      </a>
    </h3>

    <p class="text-sm text-slate-400 line-clamp-3 leading-relaxed">
      {excerpt}
    </p>
  </div>

  <div class="pt-4 mt-4 border-t border-slate-800/80">
    <a
      href={articleUrl}
      class="text-xs font-semibold text-emerald-400 hover:text-amber-400 transition-colors flex items-center gap-1.5"
    >
      Baca Panduan Lengkap <span class="group-hover:translate-x-1 transition-transform">→</span>
    </a>
  </div>
</article>
