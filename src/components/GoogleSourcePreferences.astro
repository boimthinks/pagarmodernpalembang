---
import { SITE } from '../config/site';

interface Props {
  variant?: 'cta' | 'footer' | 'inline';
  class?: string;
}

const { variant = 'cta', class: customClass = '' } = Astro.props;
const siteUrl = SITE.url || 'https://pagarmodernpalembang.com';
---

<div class={`google-source-wrapper ${variant === 'footer' ? 'w-full' : 'my-4'} ${customClass}`}>
  <button
    type="button"
    class={`js-google-source-btn inline-flex items-center justify-center gap-2.5 font-semibold transition-all duration-200 cursor-pointer ${
      variant === 'footer'
        ? 'w-full py-2.5 px-4 rounded-xl bg-slate-900 hover:bg-slate-850 text-slate-300 hover:text-white border border-slate-800 hover:border-emerald-500/50 text-xs shadow-sm'
        : 'w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 hover:from-blue-500 hover:to-indigo-500 text-white text-sm shadow-lg shadow-blue-950/50 hover:scale-102'
    }`}
    data-source-url={siteUrl}
    title="Tambahkan Pagar Modern Palembang ke Preferensi Sumber Google"
  >
    <!-- Ikon Google G Multi-Color -->
    <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
      <path
        fill="#4285F4"
        d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
      />
      <path
        fill="#34A853"
        d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
      />
      <path
        fill="#FBBC05"
        d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
      />
      <path
        fill="#EA4335"
        d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
      />
    </svg>
    <span>Tambah sebagai Sumber Favorit di Google</span>
  </button>
</div>

<script>
  function setupGoogleSourceButtons() {
    const buttons = document.querySelectorAll('.js-google-source-btn');
    buttons.forEach((btn) => {
      // Hindari duplikasi listener
      if (btn.getAttribute('data-listener-attached') === 'true') return;
      btn.setAttribute('data-listener-attached', 'true');

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const targetBtn = e.currentTarget as HTMLElement;
        const sourceUrl = targetBtn?.getAttribute('data-source-url') || 'https://pagarmodernpalembang.com';
        
        // Coba Google News API jika ada, atau direct URL fallback
        const win = window as any;
        if (win.google && win.google.news && win.google.news.sourcePreferences) {
          win.google.news.sourcePreferences.showDialog({
            forceReload: true,
            sourceUrl: sourceUrl,
          });
        } else {
          window.open(`https://www.google.com/preferences/source?q=${encodeURIComponent(sourceUrl)}`, '_blank', 'noopener,noreferrer');
        }
      });
    });
  }

  // Jalankan saat initial load dan client-side navigasi jika ada
  setupGoogleSourceButtons();
  document.addEventListener('astro:page-load', setupGoogleSourceButtons);
</script>
