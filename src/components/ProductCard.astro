---
interface Props {
  title: string;
  category: string;
  material: string;
  priceRange: string;
  excerpt: string;
  slug: string;
  featured?: boolean;
}

const { title, category, material, priceRange, excerpt, slug, featured = false } = Astro.props;
---

<div class={`group rounded-2xl bg-slate-900/70 border ${featured ? 'border-amber-500/50 shadow-amber-950/30' : 'border-slate-800 hover:border-emerald-500/50'} p-6 flex flex-col justify-between transition-all duration-300 hover:shadow-xl hover:shadow-emerald-950/30`}>
  <div class="space-y-4">
    <!-- Badges -->
    <div class="flex items-center justify-between text-xs">
      <span class="px-2.5 py-1 rounded-md bg-emerald-500/10 text-emerald-400 font-semibold border border-emerald-500/20 uppercase tracking-wide">
        {category}
      </span>
      {featured && (
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 font-medium border border-amber-500/30">
          <span class="material-symbols-outlined text-[13px] leading-none">star</span>
          Unggulan
        </span>
      )}
    </div>

    <!-- Title -->
    <h3 class="text-xl font-bold text-white group-hover:text-emerald-400 transition-colors leading-snug">
      <a href={`/${slug}`}>
        {title}
      </a>
    </h3>

    <!-- Excerpt -->
    <p class="text-sm text-slate-400 line-clamp-2 leading-relaxed">
      {excerpt}
    </p>

    <!-- Specs Meta -->
    <div class="pt-3 border-t border-slate-800/80 space-y-1.5 text-xs text-slate-300">
      <div class="flex justify-between">
        <span class="text-slate-500">Material:</span>
        <span class="font-medium text-slate-200">{material}</span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-500">Estimasi:</span>
        <span class="font-semibold text-emerald-400">{priceRange}</span>
      </div>
    </div>
  </div>

  <!-- Link Button -->
  <div class="pt-5 mt-4 border-t border-slate-800 flex items-center justify-between">
    <a
      href={`/${slug}`}
      class="text-xs font-semibold text-emerald-400 hover:text-amber-400 transition-colors flex items-center gap-1"
    >
      Detail Spesifikasi <span>→</span>
    </a>
    <a
      href={`https://wa.me/6285215111125?text=Halo%20Sriwijaya%20Grafika%2C%20saya%20tertarik%20dengan%20produk%20${encodeURIComponent(title)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="text-xs font-medium px-3 py-1.5 rounded-lg bg-emerald-600/20 hover:bg-emerald-600 text-emerald-300 hover:text-white transition-all"
    >
      Tanya Harga
    </a>
  </div>
</div>
