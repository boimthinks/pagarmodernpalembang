---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Halaman Tidak Ditemukan (404)"
  description="Halaman yang Anda tuju tidak ditemukan di Pagar Modern Palembang by Sriwijaya Grafika."
  noindex={true}
>
  <div class="max-w-3xl mx-auto px-4 py-24 text-center space-y-6">
    <div class="text-6xl font-extrabold text-emerald-400">404</div>
    <h1 class="text-3xl font-bold text-white">Halaman Tidak Ditemukan</h1>
    <p class="text-slate-400 text-sm max-w-md mx-auto leading-relaxed">
      Mohon maaf, halaman yang Anda cari mungkin telah dipindahkan atau tautan tidak valid. Silakan kembali ke katalog utama kami.
    </p>
    <div class="pt-4 flex items-center justify-center gap-4">
      <a href="/" class="px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm">
        Kembali ke Beranda
      </a>
      <a href="/pagar" class="px-6 py-3 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:text-white text-sm font-semibold">
        Lihat Pagar Cutting
      </a>
    </div>
  </div>
</BaseLayout>
