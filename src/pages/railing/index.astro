---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaWhatsapp from '../../components/CtaWhatsapp.astro';
import MaterialTable from '../../components/MaterialTable.astro';
import MotifCard from '../../components/MotifCard.astro';
import { getCollection } from 'astro:content';

const railingMotifs = await getCollection('blog', ({ data }) => data.published && data.label_produk === 'railing' && data.tipe === 'motif');

const pricingTiersRailing = [
  {
    grade: 'Railing Minimalis Plat Kisi Modern',
    plat: 'Plat Besi Galvanis 1.8 mm',
    frame: 'Hollow Galvanis 40x40 mm tebal 1.4 mm',
    handrail: 'Hollow Galvanis 40x60 mm cat duco doff',
    price: 'Rp 1.100.000, Rp 1.450.000',
    bestFor: 'Tangga rumah klaster modern minimalis dengan bentang lurus',
  },
  {
    grade: 'Railing Kombinasi Handrail Kayu Solid',
    plat: 'Plat Besi Galvanis 2.0 mm',
    frame: 'Hollow Galvanis 40x40 mm tebal 1.4 mm',
    handrail: 'Kayu Kamper Oven atau Jati profil ergonomis',
    price: 'Rp 1.550.000, Rp 2.100.000',
    bestFor: 'Interior rumah tinggal bertingkat bernuansa hangat dan mewah',
    featured: true,
  },
  {
    grade: 'Railing Ornamen Mewah Motif Songket',
    plat: 'Plat Besi Galvanis 2.0 mm, 2.4 mm',
    frame: 'Hollow Galvanis 40x40 / 40x60 mm tebal 1.4 mm',
    handrail: 'Pipa bulat galvanis 2 inch atau kayu solid',
    price: 'Rp 1.650.000, Rp 2.300.000',
    bestFor: 'Tangga utama foyer rumah klasik megah dan void lantai dua',
  },
  {
    grade: 'Railing Full Stainless Steel 304',
    plat: 'Plat Stainless 304 tebal 1.5 mm, 2.0 mm',
    frame: 'Hollow Stainless 40x40 mm tebal 1.2 mm',
    handrail: 'Pipa stainless 2 inch hairline atau mirror finish',
    price: 'Rp 2.200.000, Rp 3.100.000',
    bestFor: 'Tangga outdoor, area servis terbuka, dan void modern kontemporer',
  },
];

const faqsRailing = [
  {
    question: 'Bagaimana cara memotong plat laser agar kemiringannya pas dengan anak tangga?',
    answer: 'Teknisi kami melakukan pengukuran sudut derajat kemiringan tangga (rata-rata 32 hingga 36 derajat) serta tinggi tanjakan (riser) dan lebar pijakan (tread). Data derajat tersebut dimasukkan ke program AutoCAD sehingga motif laser terpotong miring presisi mengikuti alur anak tangga tanpa ada ornamen yang terdistorsi.',
  },
  {
    question: 'Apakah railing tangga plat laser cutting aman dipegang anak dan lansia?',
    answer: 'Sangat aman. Seluruh tepi pemotongan laser dihaluskan hingga tumpul bebas sisi tajam. Selain itu, kami melengkapi bagian atas dengan handrail kayu profil membulat atau hollow halus yang nyaman digenggam kuat saat menaiki tangga.',
  },
  {
    question: 'Apakah pemasangan tiang railing membuat tapak anak tangga menjadi sempit?',
    answer: 'Jika tangga Anda berukuran sempit di bawah 90 cm, kami menyediakan sistem pemasangan side-mount (ditanam pada sisi samping balok beton tangga). Sistem ini tidak memakan lebar tapak keramik sama sekali sehingga ruang lalu lintas tangga tetap lapang.',
  },
  {
    question: 'Berapa tinggi standar railing tangga yang ergonomis dan aman?',
    answer: 'Standar tinggi pegangan yang kami terapkan adalah 85 sampai 90 cm diukur tegak lurus dari ujung hidung tapak anak tangga (nosing step). Ketinggian ini adalah titik ergonomis paling nyaman bagi lengan orang dewasa.',
  },
];
---

<BaseLayout
  title="Railing Tangga Plat Laser Cutting Mewah Palembang"
  description="Jasa pembuatan railing tangga plat cutting laser di Palembang. Kombinasi handrail kayu solid & stainless, presisi sudut derajat tangga Sriwijaya Grafika."
  ogImage="/produk/railing-tangga-laser-cutting_poco.webp"
  schemaType="Product"
  schemaData={{
    name: 'Railing Tangga Laser Cutting Palembang',
    description: 'Railing tangga plat cutting laser kombinasi handrail kayu dan stainless Sriwijaya Grafika Palembang',
    image: '/produk/railing-tangga-laser-cutting_poco.webp',
    lowPrice: '1100000',
    highPrice: '3100000',
    offerCount: '8',
  }}
  breadcrumbs={[
    { name: 'Railing Tangga Laser Cutting', url: '/railing/' }
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-20">
    <Breadcrumb items={[
      { name: 'Railing Tangga Laser Cutting', url: '/railing/' }
    ]} />

    <!-- HERO SECTION -->
    <header class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-emerald-500/10 text-emerald-400 text-xs font-semibold uppercase tracking-wider border border-emerald-500/20">
          Railing Pagar Palembang
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Railing Tangga Laser Cutting Palembang dan Pembatas Void Interior Mewah
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
          Railing tangga bukan sekadar pegangan pengaman, melainkan poros estetika interior yang menghubungkan lantai rumah Anda. Workshop Sriwijaya Grafika memproduksi railing tangga dan pembatas void berbahan plat galvanis atau stainless steel potong fiber laser. Dirancang dengan perhitungan sudut kemiringan presisi, perpaduan pegangan tangan kayu solid yang hangat, serta hasil pengerjaan rapi ramah sentuhan tangan keluarga Anda.
        </p>

        <div class="flex flex-wrap gap-4 pt-2">
          <a
            href="https://wa.me/6285215111125?text=Halo%20Sriwijaya%20Grafika%2C%20saya%20ingin%20konsultasi%20pembuatan%20Railing%20Tangga%20Laser%20Cutting"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-500 hover:from-emerald-500 hover:to-emerald-400 text-white font-bold text-sm shadow-lg shadow-emerald-950 transition-all"
          >
            Konsultasi Ukuran & Sudut Tangga
          </a>
          <a
            href="/motif-laser-cutting/"
            class="px-6 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-semibold text-sm border border-slate-700 transition-colors"
          >
            Katalog Desain Ornamen Motif →
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="relative rounded-3xl overflow-hidden border border-slate-800 bg-slate-950 aspect-[4/3] shadow-2xl shadow-emerald-950/40 group">
          <img
            src="/produk/railing-tangga-laser-cutting_poco.webp"
            alt="Railing tangga laser cutting Palembang Sriwijaya Grafika"
            width="800"
            height="600"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent pointer-events-none"></div>
          <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-xs">
            <span class="px-2.5 py-1 rounded-lg bg-slate-900/90 text-white font-medium border border-slate-700/80 backdrop-blur-sm">
              Workshop Talang Jambe
            </span>
            <span class="text-emerald-400 font-semibold bg-emerald-950/80 px-2.5 py-1 rounded-lg border border-emerald-500/30">
              Presisi Sudut Derajat
            </span>
          </div>
        </div>
      </div>
    </header>

    <!-- SECTION 1: DESAIN MOTIF RAILING TANGGA -->
    <section class="space-y-8">
      <div>
        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Katalog Desain</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1">Desain Motif Railing Tangga Laser Cutting</h2>
        <p class="text-slate-400 text-sm mt-1">Inspirasi motif potong laser yang dirancang simetris mengikuti sudut tanjakan tangga rumah Anda.</p>
      </div>

      {railingMotifs.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {railingMotifs.map((m) => (
            <MotifCard
              title={m.data.title}
              excerpt={m.data.excerpt}
              slug={m.id}
              kategori={m.data.label_produk}
              topik={m.data.topik}
              imgurl={m.data.imgurl}
              imgalt={m.data.imgalt}
            />
          ))}
        </div>
      ) : (
        <div class="p-8 rounded-3xl bg-slate-900/60 border border-slate-800 flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="space-y-2">
            <h3 class="text-lg font-bold text-white">Desain Motif Railing Tangga Siap Kustom</h3>
            <p class="text-xs text-slate-400 max-w-xl leading-relaxed">
              Tersedia beragam pola geometris, sulur flora, atau kisi modern yang dipotong dengan kemiringan derajat sesuai tangga Anda. Kirimkan foto denah tangga Anda via WhatsApp untuk mockup 3D gratis.
            </p>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <a
              href="/motif-laser-cutting/"
              class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs border border-slate-700 transition-colors"
            >
              Lihat Galeri Motif →
            </a>
            <a
              href="https://wa.me/6285215111125?text=Halo%20Sriwijaya%20Grafika%2C%20saya%20ingin%20request%20katalog%20motif%20railing%20tangga"
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition-colors"
            >
              Request Mockup WA
            </a>
          </div>
        </div>
      )}
    </section>

    <!-- SECTION 1: PILIHAN MODEL RAILING -->
    <section class="space-y-8">
      <div>
        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Pilihan Konsep Ruang</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1">Pilihan Model Railing Tangga Plat Cutting Modern</h2>
        <p class="text-slate-400 text-sm mt-1">Menyelaraskan tema arsitektur interior rumah mulai dari gaya minimalis kontemporer hingga klasik megah.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-8 rounded-3xl bg-slate-900/80 border border-slate-800 hover:border-emerald-500/50 transition-all flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold text-xl">
              01
            </div>
            <h3 class="text-xl font-bold text-white">Railing Tangga Kisi Geometris</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Menggunakan pola garis modular simetris, sarang lebah hexagon, atau celah asimetris modern. Tampilan bersih dan rapi yang sangat cocok untuk rumah tipe split-level dan klaster perumahan bertingkat di Palembang.
            </p>
            <div class="text-xs text-emerald-400 font-semibold pt-1">
              Konsep Modern Simpel
            </div>
          </div>
        </div>

        <div class="p-8 rounded-3xl bg-slate-900/80 border border-slate-800 hover:border-amber-500/50 transition-all flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-400 flex items-center justify-center font-bold text-xl">
              02
            </div>
            <h3 class="text-xl font-bold text-white">Railing Motif Daun dan Songket Etnik</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Koleksi motif sulur daun monstera, flora tropis, atau ornamen songket khas Palembang. Memberikan sentuhan karya seni eksklusif yang memikat setiap mata saat melangkah masuk ke ruang tamu utama.
            </p>
            <div class="text-xs text-amber-400 font-semibold pt-1">
              Fokus Utama Ruang Tamu Mewah
            </div>
          </div>
        </div>

        <div class="p-8 rounded-3xl bg-slate-900/80 border border-slate-800 hover:border-teal-500/50 transition-all flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-teal-500/10 text-teal-400 flex items-center justify-center font-bold text-xl">
              03
            </div>
            <h3 class="text-xl font-bold text-white">Pembatas Void dan Mezzanine</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Pengaman area bukaan void lantai dua atau ruang mezzanine terbuka. Panel plat berdiri tegak lurus dengan handrail panjang yang menyatu sempurna menjaga keselamatan seluruh anggota keluarga.
            </p>
            <div class="text-xs text-teal-400 font-semibold pt-1">
              Pengaman Area Terbuka Lantai Dua
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: TEKNIS KEMIRINGAN TANGGA -->
    <section class="rounded-3xl bg-slate-900/40 border border-slate-800 p-8 sm:p-12 space-y-8">
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Kepresisian Geometris</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white">Pengukuran Kemiringan Derajat dan Standar Ergonomi Tangga</h2>
        <p class="text-slate-300 text-sm leading-relaxed">
          Tantangan terbesar dalam pembuatan railing tangga plat laser cutting adalah sinkronisasi kemiringan sudut. Jika salah ukur satu derajat saja, motif laser akan tampak miring tidak seirama dengan anak tangga.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-sm text-slate-300">
        <div class="space-y-4 p-6 rounded-2xl bg-slate-950/60 border border-slate-800/80">
          <h3 class="text-lg font-bold text-white">Kalkulasi Kemiringan Derajat Sudut Tangga</h3>
          <p class="leading-relaxed">
            Teknisi kami mengukur setiap trap anak tangga secara individu menggunakan busur derajat digital dan meteran laser. Kami menghitung rasio optrede (tanjakan) dan aantrede (pijakan) sehingga pola motif plat dipotong dengan kemiringan yang sejajar persis dengan sudut tanjakan tangga rumah Anda.
          </p>
          <div class="p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-xs text-emerald-300">
            Motif potong laser mengalir harmonis tanpa ada bidang ornamen yang terpotong janggal di bordes tanjakan.
          </div>
        </div>

        <div class="space-y-4 p-6 rounded-2xl bg-slate-950/60 border border-slate-800/80">
          <h3 class="text-lg font-bold text-white">Opsi Pemasangan Top-Mount dan Side-Mount</h3>
          <p class="leading-relaxed">
            Kami menyediakan dua metode pemasangan tiang utama. Metode top-mount ditanam langsung di atas tapak keramik anak tangga untuk konstruksi standar. Sedangkan metode side-mount dipasang pada dinding samping balok beton tangga menggunakan baut dynabolt kokoh untuk memaksimalkan area pijakan kaki pada tangga berukuran sempit.
          </p>
          <div class="p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/20 text-xs text-amber-300">
            Sistem side-mount menghemat ruang tangga hingga 10 cm lebih lapang.
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: MATERIAL HANDRAIL -->
    <section class="space-y-8">
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Kenyamanan Sentuhan Tangan</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white">Kombinasi Material Handrail Kayu Solid dan Stainless Steel</h2>
        <p class="text-slate-300 text-sm leading-relaxed">
          Kualitas sebuah railing dinilai langsung dari kenyamanan genggaman tangan saat melangkah naik dan turun. Kami menyediakan berbagai pilihan material handrail berkualitas tinggi.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-3">
          <div class="text-emerald-400 font-bold text-base">Handrail Kayu Kamper Oven</div>
          <p class="text-xs text-slate-400 leading-relaxed">
            Kayu solid yang telah melalui pengeringan oven terukur agar tidak melintir atau susut. Diberi profil lengkung halus dan dilapisi melamin doff untuk sentuhan hangat alami di dalam ruangan.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-3">
          <div class="text-amber-400 font-bold text-base">Handrail Hollow Cat Duco PU</div>
          <p class="text-xs text-slate-400 leading-relaxed">
            Pipa hollow galvanis 40x60 mm dengan sambungan las rata tanpa tonjolan tajam. Diberi cat duco polyurethane lembut yang tidak meninggalkan bekas keringat tangan dan mudah dibersihkan.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-3">
          <div class="text-teal-400 font-bold text-base">Handrail Stainless Steel 304</div>
          <p class="text-xs text-slate-400 leading-relaxed">
            Pipa bulat stainless steel grade 304 dengan tekstur hairline elegan. Anti noda, bebas karat, dan memberikan nuansa modern industrial yang sangat bersih.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 4: TABEL ESTIMASI HARGA RAILING -->
    <section class="space-y-8">
      <div>
        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Estimasi Biaya Transparan</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1">Estimasi Spesifikasi dan Perhitungan Biaya Railing per Meter Lari</h2>
        <p class="text-slate-400 text-sm mt-1">
          Harga dihitung per meter lari panjang tanjakan tangga (tinggi standar 85 sampai 90 cm), sudah termasuk plat motif laser, tiang hollow, handrail pegangan, cat duco, dan instalasi di Palembang.
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-slate-800">
        <table class="w-full text-left text-sm text-slate-300">
          <thead class="bg-slate-900 text-xs uppercase text-slate-400 tracking-wider border-b border-slate-800">
            <tr>
              <th class="py-4 px-6 font-semibold">Tipe Spesifikasi</th>
              <th class="py-4 px-6 font-semibold">Bahan Plat & Tebal</th>
              <th class="py-4 px-6 font-semibold">Rangka Bingkai Hollow</th>
              <th class="py-4 px-6 font-semibold text-emerald-400">Estimasi Biaya / m¹</th>
              <th class="py-4 px-6 font-semibold">Spesifikasi Handrail</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800 bg-slate-950/60">
            {pricingTiersRailing.map((row) => (
              <tr class={row.featured ? 'bg-emerald-950/20' : 'hover:bg-slate-900/40 transition-colors'}>
                <td class="py-4 px-6 font-bold text-white">
                  {row.grade}
                  {row.featured && (
                    <span class="ml-2 px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                      Favorit Interior
                    </span>
                  )}
                </td>
                <td class="py-4 px-6">{row.plat}</td>
                <td class="py-4 px-6">{row.frame}</td>
                <td class="py-4 px-6 font-bold text-emerald-400 whitespace-nowrap">{row.price}</td>
                <td class="py-4 px-6 text-xs text-slate-400">{row.handrail}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="text-xs text-slate-400 italic">
        Catatan, untuk tangga dengan bordes putar (tangga melingkar atau spiral), perhitungan pola potong laser memerlukan pengukuran bertahap di lokasi oleh teknisi kami.
      </p>
    </section>

    <!-- SECTION 5: MATERIAL TABLE -->
    <section class="space-y-6">
      <div>
        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Fasilitas Mesin Produksi</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1">Kapasitas Mesin Pemotongan Plat Fiber Laser Presisi</h2>
        <p class="text-slate-400 text-sm mt-1">Dipotong menggunakan teknologi fiber laser otomatis di workshop Talang Jambe Sukarami.</p>
      </div>

      <MaterialTable />
    </section>

    <!-- SECTION 6: TAHAPAN PEMBUATAN -->
    <section class="space-y-8">
      <div>
        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">SOP Pengerjaan Interior</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1">Tahapan Fabrikasi dan Pemasangan Railing Tangga Sriwijaya Grafika</h2>
        <p class="text-slate-400 text-sm mt-1">Alur kerja teliti menjaga kebersihan lantai keramik dan kepresisian sambungan tangga Anda.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-2">
          <div class="text-emerald-400 font-extrabold text-sm">Langkah 01</div>
          <h3 class="text-base font-bold text-white">Survei Pengukuran Derajat Digital</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Teknisi kami mengukur setiap anak tangga dengan meteran laser dan alat ukur sudut derajat digital untuk memetakan tanjakan tangga secara akurat.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-2">
          <div class="text-emerald-400 font-extrabold text-sm">Langkah 02</div>
          <h3 class="text-base font-bold text-white">Penyesuaian Sudut Desain CAD</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Motif ornamen laser diposisikan miring di dalam program CAD mengikuti sudut tangga, memastikan ornamen tidak terpotong canggung pada sambungan bordes.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-2">
          <div class="text-emerald-400 font-extrabold text-sm">Langkah 03</div>
          <h3 class="text-base font-bold text-white">Pemotongan Fiber Laser Halus</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Plat dipotong menggunakan mesin laser berdaya tinggi. Seluruh sisi motif digerinda halus agar tidak ada serpihan tajam yang bisa menggores tangan.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-2">
          <div class="text-emerald-400 font-extrabold text-sm">Langkah 04</div>
          <h3 class="text-base font-bold text-white">Perakitan Modul dan Las Rapi</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Panel dirakit ke dalam bingkai tiang hollow dengan sambungan las presisi, lalu dudukan dudukan bracket handrail atas disiapkan dengan kuat.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-2">
          <div class="text-emerald-400 font-extrabold text-sm">Langkah 05</div>
          <h3 class="text-base font-bold text-white">Pengecatan Duco Halus Ramah Interior</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Pelapisan primer epoxy anti karat dilanjutkan cat duco polyurethane warna pilihan (hitam doff, abu-abu arang, atau putih) dengan hasil akhir mulus.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-2">
          <div class="text-emerald-400 font-extrabold text-sm">Langkah 06</div>
          <h3 class="text-base font-bold text-white">Instalasi Bersih di Lokasi</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Pemasangan tiang menggunakan dynabolt baja, pemasangan handrail kayu atau hollow, pembersihan serbuk bor lantai, dan serah terima garansi resmi 1 tahun.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 7: PANDUAN KONSUMEN -->
    <section class="rounded-3xl bg-slate-900/50 border border-slate-800 p-8 sm:p-10 space-y-6">
      <div class="space-y-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Tips Praktisi Bengkel</span>
        <h2 class="text-2xl font-bold text-white">Panduan Memilih Railing Tangga yang Aman dan Nyaman Dipijak</h2>
        <p class="text-slate-400 text-sm">Hal penting yang perlu Anda perhatikan sebelum menyepakati pesanan railing tangga rumah.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-slate-300">
        <div class="flex gap-4 p-4 rounded-xl bg-slate-950/60 border border-slate-800/80">
          <div class="text-emerald-400 font-bold text-lg">01</div>
          <div class="space-y-1">
            <h3 class="font-bold text-white text-sm">Uji Kekakuan dan Goyangan Tiang Utama</h3>
            <p class="text-slate-400 leading-relaxed">Railing tangga harus mampu menahan beban dorongan tiba-tiba saat seseorang kehilangan keseimbangan. Pastikan tiang utama terikat kuat dengan dynabolt tebal ke cor beton.</p>
          </div>
        </div>

        <div class="flex gap-4 p-4 rounded-xl bg-slate-950/60 border border-slate-800/80">
          <div class="text-emerald-400 font-bold text-lg">02</div>
          <div class="space-y-1">
            <h3 class="font-bold text-white text-sm">Periksa Kelancaran Sambungan Handrail</h3>
            <p class="text-slate-400 leading-relaxed">Tangan Anda akan meluncur di sepanjang pegangan saat menaiki tangga. Pastikan tidak ada baut menonjol atau tepi tajam di bawah permukaan handrail.</p>
          </div>
        </div>

        <div class="flex gap-4 p-4 rounded-xl bg-slate-950/60 border border-slate-800/80">
          <div class="text-emerald-400 font-bold text-lg">03</div>
          <div class="space-y-1">
            <h3 class="font-bold text-white text-sm">Pilih Kerapatan Motif Sesuai Anggota Keluarga</h3>
            <p class="text-slate-400 leading-relaxed">Jika memiliki balita, pilihlah motif dengan celah potong rapat agar mainan tidak mudah jatuh ke bawah dan tangan anak tidak terjepit di antara celah plat.</p>
          </div>
        </div>

        <div class="flex gap-4 p-4 rounded-xl bg-slate-950/60 border border-slate-800/80">
          <div class="text-emerald-400 font-bold text-lg">04</div>
          <div class="space-y-1">
            <h3 class="font-bold text-white text-sm">Komitmen Garansi Sambungan Las</h3>
            <p class="text-slate-400 leading-relaxed">Pastikan bengkel las memberikan jaminan perbaikan jika suatu saat tiang penopang terasa longgar atau bergetar setelah pemakaian rutin.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 8: FAQ ACCORDION -->
    <section class="space-y-6">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Pertanyaan Umum</span>
