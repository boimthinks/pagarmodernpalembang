---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaWhatsapp from '../components/CtaWhatsapp.astro';
import MaterialTable from '../components/MaterialTable.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SILO_TREE, PRODUCT_CATEGORIES } from '../data/silo';
import { SITE } from '../config/site';
import { getCollection } from 'astro:content';

const parseIndonesianDate = (dStr: string) => {
  const months: Record<string, number> = {
    'januari': 0, 'februari': 1, 'maret': 2, 'april': 3, 'mei': 4, 'juni': 5,
    'juli': 6, 'agustus': 7, 'september': 8, 'oktober': 9, 'november': 10, 'desember': 11
  };
  const parts = dStr.split(' ');
  if (parts.length === 3) {
    const day = parseInt(parts[0], 10);
    const month = months[parts[1].toLowerCase()] ?? 0;
    const year = parseInt(parts[2], 10);
    return new Date(year, month, day).getTime();
  }
  return new Date(dStr).getTime();
};

const latestArticles = (await getCollection('blog', ({ data }) => data.published && data.tipe === 'artikel'))
  .sort((a, b) => parseIndonesianDate(b.data.date) - parseIndonesianDate(a.data.date))
  .slice(0, 3);

const faqs = [
  {
    question: 'Apa keunggulan pagar laser cutting dibanding pagar tempa atau tralis biasa?',
    answer: 'Pagar laser cutting dipotong menggunakan sinar fiber laser berkekuatan tinggi dengan presisi 0.1 mm, menghasilkan motif custom bebas tanpa batas (motif daun, geometris, songket, wayang), tepian halus tanpa terak las kasar, serta tampilan modern yang sangat mewah.'
  },
  {
    question: 'Berapa ketebalan plat yang ideal untuk pagar rumah di Palembang?',
    answer: 'Untuk pagar minimalis standar, kami merekomendasikan plat besi/galvanis tebal 1.8 mm hingga 2.0 mm agar tidak melengkung saat terkena panas terik matahari Palembang. Untuk gerbang dorong lebar, tebal 2.4 mm hingga 3.4 mm adalah pilihan terbaik.'
  },
  {
    question: 'Berapa kisaran harga pagar laser cutting per meter di Sriwijaya Grafika?',
    answer: 'Harga estimasi mulai dari Rp 950.000 hingga Rp 2.400.000 per meter persegi tergantung ketebalan plat, kerumitan motif potong, dan spesifikasi rangka hollow. Kami juga memberikan survei ukuran dan mockup desain 3D gratis.'
  },
  {
    question: 'Di mana lokasi workshop dan apakah bisa survei langsung ke rumah?',
    answer: 'Workshop kami berlokasi di Jl. AMD Pertanian No.105, Talang Jambe, Sukarami, Palembang. Tim teknisi kami siap melakukan survei pengukuran langsung ke rumah Anda di seluruh wilayah Palembang dan sekitarnya.'
  }
];
---

<BaseLayout
  title="Pagar Laser Cutting Palembang Modern & Pintu Gerbang Plat Cutting Mewah"
  description="Produsen spesialis pagar laser cutting, pintu gerbang, balkon & railing plat cutting di Palembang. Presisi fiber laser 0.1mm, bergaransi by Sriwijaya Grafika."
  ogImage="/og-image.jpg"
>
  <!-- HERO SECTION -->
  <section class="relative pt-12 pb-20 sm:pt-20 sm:pb-28 overflow-hidden border-b border-slate-800">
    <div class="absolute inset-0 bg-radial from-emerald-950/40 via-transparent to-transparent pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-4xl mx-auto space-y-6">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs sm:text-sm font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          Workshop Produksi Plat Cutting Laser Terpercaya di Palembang
        </div>

        <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tight leading-tight">
          Pagar Modern & Pintu Gerbang <br class="hidden sm:block" />
          <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-amber-400 bg-clip-text text-transparent">
            Plat Laser Cutting Palembang
          </span>
        </h1>

        <p class="text-base sm:text-xl text-slate-300 max-w-3xl mx-auto leading-relaxed">
          Tingkatkan estetika dan keamanan hunian Anda dengan pagar plat besi, stainless, dan aluminium bermotif presisi fiber laser. Dibuat langsung di workshop kami di Talang Jambe, Sukarami.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={`https://wa.me/${SITE.contact.whatsapp}?text=${SITE.contact.whatsappText}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 text-white font-bold text-base shadow-xl shadow-emerald-950/60 transition-all hover:scale-103"
          >
            Konsultasi & Hitung Biaya via WhatsApp
          </a>
          <a
            href="/pagar"
            class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-semibold text-base border border-slate-700 transition-colors"
          >
            Lihat Model Pagar Terbaru
          </a>
        </div>

        <!-- Trust Stats -->
        <div class="pt-10 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto text-center border-t border-slate-800/80">
          <div class="p-3">
            <div class="text-2xl sm:text-3xl font-extrabold text-white">16+ Tahun</div>
            <div class="text-xs text-slate-400 mt-1">Pengalaman Sejak 2008</div>
          </div>
          <div class="p-3">
            <div class="text-2xl sm:text-3xl font-extrabold text-emerald-400">0.1 mm</div>
            <div class="text-xs text-slate-400 mt-1">Presisi Fiber Laser</div>
          </div>
          <div class="p-3">
            <div class="text-2xl sm:text-3xl font-extrabold text-amber-400">350+</div>
            <div class="text-xs text-slate-400 mt-1">Proyek Terpasang</div>
          </div>
          <div class="p-3">
            <div class="text-2xl sm:text-3xl font-extrabold text-white">1 Tahun</div>
            <div class="text-xs text-slate-400 mt-1">Garansi Konstruksi</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SILO HUBS SECTION -->
  <section id="produk" class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14 space-y-3">
      <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Kategori Unggulan</span>
      <h2 class="text-3xl sm:text-4xl font-bold text-white">Pilihan Produk Arsitektural Logam</h2>
      <p class="text-slate-400 text-sm">
        Jelajahi lini produk jadi siap pasang yang dirancang untuk mempercantik hunian dan bangunan komersial di Palembang.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {PRODUCT_CATEGORIES.map((cat) => (
        <a
          href={cat.url}
          class="group rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-emerald-500/50 p-5 flex flex-col justify-between transition-all duration-300 hover:shadow-2xl hover:shadow-emerald-950/40 hover:-translate-y-1 overflow-hidden"
        >
          <div class="space-y-4">
            <div class="relative aspect-[16/10] rounded-2xl overflow-hidden bg-slate-950 border border-slate-800/80">
              <img
                src={cat.image}
                alt={cat.fullName}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent pointer-events-none"></div>
              {cat.badge && (
                <span class="absolute top-3 right-3 text-[11px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-slate-900/90 text-amber-300 border border-amber-500/40 backdrop-blur-md">
                  {cat.badge}
                </span>
              )}
              <div class="absolute bottom-3 left-3 flex items-center gap-2">
                <span class="w-8 h-8 rounded-lg bg-slate-900/90 text-emerald-400 border border-emerald-500/30 flex items-center justify-center backdrop-blur-md shadow-md">
                  <span class="material-symbols-outlined text-[18px] leading-none">{cat.icon}</span>
                </span>
                <span class="text-xs font-semibold text-white drop-shadow">
                  {cat.name} Palembang
                </span>
              </div>
            </div>
            <h3 class="text-xl font-bold text-white group-hover:text-emerald-400 transition-colors">
              {cat.fullName}
            </h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              {cat.description}
            </p>
          </div>
          <div class="pt-5 mt-4 border-t border-slate-800/80 flex items-center gap-1 text-xs font-semibold text-emerald-400 group-hover:text-amber-400">
            Jelajahi {cat.name} <span>→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- MATERIAL & THICKNESS TABLE -->
  <section class="py-12 bg-slate-950/60 border-y border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-8">
        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Kapasitas 3 Mesin Workshop</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1">Fasilitas Pemotongan Bahan Laser Fiber, CNC Router & Laser CO2</h2>
        <p class="text-slate-400 text-sm mt-2 leading-relaxed">
          Workshop Sriwijaya Grafika mengoperasikan 3 jenis mesin dengan spesialisasi masing-masing: <strong>Laser Fiber</strong> khusus menangani logam (plat besi, galvanis, stainless, aluminium), <strong>CNC Router</strong> khusus menangani kayu olahan (plywood, MDF, MHR, PVC, ACP), serta <strong>Laser CO2</strong> khusus menangani akrilik presisi.
        </p>
      </div>

      <MaterialTable />
    </div>
  </section>

  <!-- LATEST ARTICLES -->
  <section class="py-16 bg-slate-900/30 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Edukasi & Panduan Biaya</span>
          <h2 class="text-3xl font-bold text-white mt-1">Artikel & Tips Arsitektur Logam</h2>
          <p class="text-slate-400 text-sm mt-1">Panduan memilih ketebalan plat dan estimasi harga per meter di Palembang.</p>
        </div>
        <a href="/blog" class="text-sm font-semibold text-emerald-400 hover:text-amber-400">
          Lihat Semua Artikel →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {latestArticles.map((art) => (
          <ArticleCard
            title={art.data.title}
            excerpt={art.data.excerpt}
            date={art.data.date}
            topik={art.data.topik}
            slug={art.id}
            kategori={art.data.label_produk}
            imgurl={art.data.imgurl}
            imgalt={art.data.imgalt}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <section class="py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 space-y-2">
      <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Tanya Jawab</span>
      <h2 class="text-3xl font-bold text-white">Pertanyaan yang Sering Diajukan (FAQ)</h2>
      <p class="text-slate-400 text-sm">Informasi penting seputar pengerjaan pagar laser cutting di Palembang.</p>
    </div>

    <div class="space-y-4">
      {faqs.map((faq) => (
        <details class="group rounded-2xl bg-slate-900/60 border border-slate-800 p-6 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer font-bold text-white text-base group-open:text-emerald-400">
            <span>{faq.question}</span>
            <span class="ml-4 transition-transform group-open:rotate-180 text-emerald-400 font-bold">▾</span>
          </summary>
          <p class="mt-4 text-sm text-slate-300 leading-relaxed border-t border-slate-800/80 pt-4">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA STRIP -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <CtaWhatsapp />
  </div>
</BaseLayout>
