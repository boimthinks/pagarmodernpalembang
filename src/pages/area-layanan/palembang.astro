---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaWhatsapp from '../../components/CtaWhatsapp.astro';
import { SITE } from '../../config/site';
---

<BaseLayout
  title="Jangkauan Layanan Pasang Pagar Laser Cutting Palembang & Sekitarnya"
  description="Layanan survei, produksi, dan pemasangan pagar modern laser cutting di seluruh kecamatan Kota Palembang: Sukarami, Alang-Alang Lebar, Ilir Timur, Ilir Barat, Sako, Plaju."
  breadcrumbs={[
    { name: 'Area Layanan', url: '/area-layanan/palembang' }
  ]}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumb items={[{ name: 'Area Layanan Palembang', url: '/area-layanan/palembang' }]} />

    <header class="max-w-3xl space-y-4 mb-12">
      <span class="inline-flex items-center px-3 py-1 rounded-md bg-emerald-500/10 text-emerald-400 text-xs font-semibold uppercase tracking-wider border border-emerald-500/20">
        Local Authority SEO
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
        Area Layanan Pemasangan Pagar Laser Cutting di Kota Palembang
      </h1>
      <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
        Workshop kami berlokasi strategis di <strong>Talang Jambe, Kecamatan Sukarami, Palembang</strong>. Kami melayani survei pengukuran, pembuatan, pengiriman, hingga instalasi terpasang rapi di seluruh penjuru Kota Palembang dan wilayah penyangga Sumatera Selatan.
      </p>
    </header>

    <div class="space-y-10 mb-16">
      <section class="p-8 rounded-3xl bg-slate-900/60 border border-slate-800">
        <h2 class="text-2xl font-bold text-white mb-6">Daftar Kecamatan yang Kami Layani di Palembang</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 text-xs">
          {SITE.geo.coverage.map((area) => (
            <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 flex items-center gap-2">
              <span class="material-symbols-outlined text-emerald-400 text-sm leading-none">location_on</span>
              <span class="font-medium text-slate-200">{area}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="p-8 rounded-3xl bg-slate-900/40 border border-slate-800 space-y-4 text-slate-300 leading-relaxed">
        <h2 class="text-2xl font-bold text-white">Layanan Luar Kota Palembang (Sumatera Selatan)</h2>
        <p>
          Selain Kota Palembang, workshop Sriwijaya Grafika juga menerima pesanan pengiriman modul pagar laser cutting siap pasang ke wilayah:
        </p>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm text-slate-300">
          <li>• Banyuasin (Pangkalan Balai, Betung, Talang Kelapa)</li>
          <li>• Ogan Ilir (Indralaya, Tanjung Raja)</li>
          <li>• Prabumulih & Muara Enim</li>
          <li>• Ogan Komering Ilir (Kayuagung)</li>
        </ul>
      </section>
    </div>

    <CtaWhatsapp
      title="Jadwalkan Survei Pagar ke Lokasi Rumah Anda di Palembang"
      subtitle="Teknisi kami siap datang membawa contoh potongan plat dan mengukur kebutuhan bentang pagar Anda secara presisi."
    />
  </div>
</BaseLayout>
